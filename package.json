{
  "name": "sqlite-vite-manager",
  "version": "1.0.0",
  "description": "Gerenciador SQLite com Vite e Express",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n \"server,client\" -c \"blue,green\" \"node server.js\" \"vite\"",
    "dev:client": "vite",
    "dev:server": "node --watch server.js",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node server.js"
  },
  "keywords": [
    "sqlite",
    "vite",
    "express",
    "fullstack"
  ],
  "dependencies": {
    "express": "^5.2.1",
    "sqlite": "^5.1.1",
    "sqlite3": "^6.0.1"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "vite": "^8.3.2"
  }
}
